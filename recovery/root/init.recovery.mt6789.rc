on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1

    insmod /lib/modules/touch_boost.ko
    insmod /lib/modules/mtk_ioctl_touch_boost.ko
    insmod /lib/modules/xiaomi_touch.ko
    insmod /lib/modules/gt9916k.ko

on early-fs
    start vold

on fs
    mount_all /first_stage_ramdisk/fstab.mt6789 --late

on boot
    setprop sys.usb.config adb
    chown system system /dev/xiaomi-touch
    chmod 0664 /dev/xiaomi-touch
    chown system system /sys/class/touch/tp_dev/fod_status
    chmod 0664 /sys/class/touch/tp_dev/fod_status

    # Control de brillo para OrangeFox
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness

    chown system system /sys/class/leds/lcd-backlight/led_type
    chmod 0664 /sys/class/leds/lcd-backlight/led_type
