on init
    setprop crypto.ready 1
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0

    insmod /lib/modules/touch_boost.ko
    insmod /lib/modules/mtk_ioctl_touch_boost.ko
    insmod /lib/modules/xiaomi_touch.ko
    insmod /lib/modules/gt9916k.ko

on fs && property:ro.debuggable=0
    start adbd

on property:ro.crypto.state=unsupported
    stop keymint-mitee
    stop vendor.gatekeeper-1-0
    stop tee-supplicant
    stop miteelog

on property:ro.crypto.state=unencrypted
    stop keymint-mitee
    stop vendor.gatekeeper-1-0
    stop tee-supplicant
    stop miteelog

on property:crypto.ready=0
    stop keymint-mitee
    stop vendor.gatekeeper-1-0
    stop tee-supplicant
    stop miteelog

on property:twrp.decrypt.done=true
    stop keymint-mitee
    stop vendor.gatekeeper-1-0
    stop tee-supplicant
    stop miteelog

on boot
    chown system system /dev/xiaomi-touch
    chmod 0664 /dev/xiaomi-touch
    chown system system /sys/class/touch/tp_dev/fod_status
    chmod 0664 /sys/class/touch/tp_dev/fod_status
