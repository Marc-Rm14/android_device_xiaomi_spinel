import /init.recovery.project.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0

    # Carga de módulos táctiles esenciales
    insmod /lib/modules/touch_boost.ko
    insmod /lib/modules/mtk_ioctl_touch_boost.ko
    insmod /lib/modules/xiaomi_touch.ko
    insmod /lib/modules/gt9916k.ko

on fs && property:ro.debuggable=0
    # distinguish USB shoulde connect or not, i.e. CDP vs SDP
    # write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd

on boot
    # Permisos para los nodos táctiles
    chown system system /dev/xiaomi-touch
    chmod 0664 /dev/xiaomi-touch
    chown system system /sys/class/touch/tp_dev/fod_status
    chmod 0664 /sys/class/touch/tp_dev/fod_status
