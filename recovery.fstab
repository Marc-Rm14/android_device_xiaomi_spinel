# Android fstab for Redmi Note 15 (spinel) - MT6789
# <src> <mnt_point> <type> <mnt_flags> <fs_mgr_flags>

# Data, metadata, cache
/dev/block/by-name/userdata /data f2fs rw wait,check,formattable,quota,resize,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/userdata /data ext4 rw wait,check,formattable,quota,resize
/dev/block/by-name/metadata /metadata ext4 rw wait,check,formattable
/dev/block/by-name/rescue /cache ext4 rw wait,check,formattable

# Vendor special partitions
/dev/block/by-name/nvdata /mnt/vendor/nvdata ext4 rw wait,check
/dev/block/by-name/nvcfg /mnt/vendor/nvcfg ext4 rw wait,check
/dev/block/by-name/protect1 /mnt/vendor/protect_f ext4 rw wait,check
/dev/block/by-name/protect2 /mnt/vendor/protect_s ext4 rw wait,check
/dev/block/by-name/persist /mnt/vendor/persist ext4 rw wait,check

# Boot-critical partitions (para flasheo)
/dev/block/by-name/boot /boot emmc defaults defaults
/dev/block/by-name/vendor_boot /vendor_boot emmc defaults defaults
/dev/block/by-name/dtbo /dtbo emmc defaults defaults
/dev/block/by-name/vbmeta /vbmeta emmc defaults defaults
/dev/block/by-name/vbmeta_system /vbmeta_system emmc defaults defaults
/dev/block/by-name/vbmeta_vendor /vbmeta_vendor emmc defaults defaults
/dev/block/by-name/misc /misc emmc defaults defaults
/dev/block/by-name/logo /logo emmc defaults defaults
/dev/block/by-name/frp /persistent emmc defaults defaults
/dev/block/by-name/nvram /nvram emmc defaults defaults
/dev/block/by-name/proinfo /proinfo emmc defaults defaults
/dev/block/by-name/seccfg /seccfg emmc defaults defaults

# External storage
/devices/platform/soc/11240000.mmc* auto auto defaults voldmanaged=sdcard1:auto
/devices/platform/soc/mt_usb* auto vfat defaults voldmanaged=usbotg:auto
